generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// LEVEL 1: Authentication & Multi-Role
// ==========================================

// Satu user bisa memiliki banyak role di dalam array
enum Role {
  ADMIN
  SELLER
  BUYER
  DRIVER
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  password     String
  fullName     String?
  roles        Role[]   @default([BUYER]) // PostgreSQL mendukung array enum
  
  // Relasi
  store        Store?             // Sebagai Seller (1 User = 1 Toko)
  addresses    Address[]          // Sebagai Buyer
  cartItems    CartItem[]         // Sebagai Buyer
  orders       Order[]            // Sebagai Buyer (Riwayat Belanja)
  deliveryJobs DeliveryJob[]      // Sebagai Driver (Riwayat Pekerjaan)
  wallet       WalletTransaction[]// Untuk pencatatan saldo Buyer / penghasilan Driver & Seller

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Fitur Level 1: Public Application Review (Tanpa harus checkout)
model AppReview {
  id           String   @id @default(uuid())
  reviewerName String   // Bisa diisi Guest atau ditarik dari User
  rating       Int      // 1 sampai 5
  comment      String   @db.Text
  createdAt    DateTime @default(now())
}


// ==========================================
// LEVEL 2: Seller Experience & Catalog
// ==========================================

model Store {
  id          String    @id @default(uuid())
  name        String    @unique // Nama toko harus unik
  ownerId     String    @unique
  owner       User      @relation(fields: [ownerId], references: [id])
  
  products    Product[]
  orders      Order[]   // Pesanan yang masuk ke toko ini
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id          String    @id @default(uuid())
  name        String
  description String    @db.Text
  price       Int
  stock       Int       // Wajib untuk sistem checkout Level 3
  
  storeId     String
  store       Store     @relation(fields: [storeId], references: [id])
  
  cartItems   CartItem[]
  orderItems  OrderItem[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}


// ==========================================
// LEVEL 3: Buyer Wallet, Cart & Checkout
// ==========================================

model Address {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  label       String   // "Rumah", "Kantor"
  addressLine String   @db.Text
  orders      Order[]
}

// Transaksi Saldo (Wallet) untuk Buyer, Seller, dan Driver
enum TransactionType {
  TOP_UP        // Buyer isi saldo
  PAYMENT       // Buyer bayar pesanan
  INCOME        // Seller terima uang masuk / Driver terima ongkos kirim
  REFUND        // Pengembalian dana Overdue (Level 6)
  REVERSAL      // Penarikan dana dari Seller jika Overdue (Level 6)
}

model WalletTransaction {
  id          String          @id @default(uuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id])
  amount      Int
  type        TransactionType
  description String?         // "Pembayaran Order ODR-123", "Top Up", dll.
  createdAt   DateTime        @default(now())
}

model CartItem {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Int      @default(1)

  // Bantuan validasi Single-Store Checkout di backend
  @@unique([userId, productId]) 
}


// ==========================================
// LEVEL 4 & 5: Order, Status History, & Delivery
// ==========================================

// Status Pesanan Wajib sesuai dokumen SEAPEDIA
enum OrderStatus {
  SEDANG_DIKEMAS    // 1. Setelah Buyer checkout sukses
  MENUNGGU_PENGIRIM // 2. Setelah Seller klik "Proses"
  SEDANG_DIKIRIM    // 3. Setelah Driver ambil pekerjaan
  PESANAN_SELESAI   // 4. Setelah Driver konfirmasi sampai
  DIKEMBALIKAN      // 5. Jika terjadi Overdue (Level 6)
}

enum DeliveryMethod {
  INSTANT
  NEXT_DAY
  REGULAR
}

model Order {
  id             String          @id @default(uuid())
  buyerId        String
  buyer          User            @relation(fields: [buyerId], references: [id])
  storeId        String          // Ditambahkan agar mudah query pendapatan per toko
  store          Store           @relation(fields: [storeId], references: [id])
  addressId      String 
  address        Address         @relation(fields: [addressId], references: [id])

  // Komponen Finansial Checkout
  subtotal       Int
  discountAmount Int             @default(0)
  deliveryFee    Int
  ppnAmount      Int             // PPN 12%
  finalTotal     Int

  deliveryMethod DeliveryMethod
  status         OrderStatus     @default(SEDANG_DIKEMAS)

  // Penggunaan Diskon (Level 4)
  voucherId      String?
  voucher        Voucher?        @relation(fields: [voucherId], references: [id])
  promoId        String?
  promo          Promo?          @relation(fields: [promoId], references: [id])

  items          OrderItem[]
  statusHistory  OrderStatusHistory[]
  deliveryJob    DeliveryJob?

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Int
  priceAtBuy  Int      // Merekam harga saat dibeli agar tidak berubah jika harga produk diubah Seller
}

// "Every order must store status history with timestamps"
model OrderStatusHistory {
  id          String       @id @default(uuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      OrderStatus
  createdAt   DateTime     @default(now())
}

// Workflow Driver (Level 5)
model DeliveryJob {
  id          String   @id @default(uuid())
  orderId     String   @unique
  order       Order    @relation(fields: [orderId], references: [id])
  
  driverId    String?  // Kosong saat status "Menunggu Pengirim", terisi saat di-"Take"
  driver      User?    @relation(fields: [driverId], references: [id])
  
  driverFee   Int      // Penghasilan yang akan masuk ke Wallet driver
  
  takenAt     DateTime?
  completedAt DateTime?
}


// ==========================================
// LEVEL 4 & 6: Discounts (Voucher & Promo)
// ==========================================

model Voucher {
  id             String   @id @default(uuid())
  code           String   @unique
  discountValue  Int      // Bisa rupiah atau persentase, handle logikanya di backend
  expiryDate     DateTime
  usageQuota     Int      // Vouchers with no remaining usage cannot be used
  
  orders         Order[]  // Riwayat order yang memakai voucher ini
  
  createdAt      DateTime @default(now())
}

model Promo {
  id             String   @id @default(uuid())
  code           String   @unique
  discountValue  Int      
  expiryDate     DateTime // Promo hanya butuh expiry, tidak butuh quota
  
  orders         Order[]  // Riwayat order yang memakai promo ini
  
  createdAt      DateTime @default(now())
}